[Unit]
Description=Yvy Backend (Lua)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User={{ yvy_user }}
Group={{ yvy_group }}
WorkingDirectory={{ app_dir }}
Environment=HOME=/home/{{ yvy_user }}
Environment=YVY_LOCAL_DEV=0
Environment=PYTHON={{ app_dir }}/.venv/bin/python
Environment=PLAYWRIGHT_BROWSERS_PATH=/home/{{ yvy_user }}/.cache/ms-playwright
ExecStart=/usr/bin/bash {{ app_dir }}/scripts/dev/run-lua.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
