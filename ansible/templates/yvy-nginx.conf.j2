# Yvy nginx — TLS terminator + reverse proxy
#
# Architecture:
#   Browser :443 → nginx (TLS)
#       ├─ /api/*     → Lua backend :5000 (direct, avoids C server 502 race)
#       ├─ /health    → Lua backend :5000
#       └─ everything → C server :5001 (static files only)
#
# Note: www.{{ domain }} has no DNS record — not included in server_name.

# HTTP → HTTPS redirect + ACME challenges
server {
    listen 80;
    server_name {{ domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server
server {
    listen 443 ssl;
    server_name {{ domain }} _;

    # SSL certificates (managed by certbot)
    # ssl_live_dir is discovered by the playbook and points at the actual
    # lineage (may be {{ domain }}-0001 if the original had a broken www domain).
    ssl_certificate {{ ssl_live_dir }}/fullchain.pem;
    ssl_certificate_key {{ ssl_live_dir }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Gzip (the C server doesn't compress; do it here)
    # This file is the SOURCE OF TRUTH for the full-Brazil /api/fires gzip behavior.
    # Do NOT remove `application/json` / `application/javascript` from gzip_types —
    # `scripts/dev/verify-gzip.sh` in CI asserts they are present. See README.en.md
    # "Full-Brazil fire payload (gzip)".
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json application/javascript image/svg+xml;

    # Security headers (also set by C server, but be explicit at edge)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Health check — bypass C server, hit Lua backend directly
    location = /health {
        proxy_pass http://127.0.0.1:5000/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # API requests → Lua backend directly (bypass C server to avoid 502 race)
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Inject X-API-Key server-side (playbook passes api_key from .env) so
        # the browser never sees the secret. If api_key is empty/undefined we
        # degrade to current behavior (no header) and leave a warning comment.
        {% if api_key | default('', true) | trim %}
        proxy_set_header X-API-Key "{{ api_key }}";
        {% else %}
        # WARNING: api_key is empty/undefined — X-API-Key NOT injected.
        # The API is open at the edge. Set API_KEY in .env and re-run the playbook.
        {% endif %}
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering on;
    }

    # Everything else → C server (static files only)
    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering on;
    }
}
