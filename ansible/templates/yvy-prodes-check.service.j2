[Unit]
Description=Yvy PRODES auto-update check (Inc 5)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ yvy_user }}
Group={{ yvy_group }}
WorkingDirectory={{ app_dir }}
Environment=HOME=/home/{{ yvy_user }}
Environment=YVY_LOCAL_DEV=0
ExecStart=/usr/bin/bash {{ app_dir }}/scripts/data/check_prodes_update.sh
StandardOutput=journal
StandardError=journal
