[Unit]
Description=Yvy Frontend (C server)
After=network.target yvy-backend.service
Wants=yvy-backend.service

[Service]
Type=simple
User={{ yvy_user }}
Group={{ yvy_group }}
WorkingDirectory={{ app_dir }}/backend-lua
EnvironmentFile=-{{ app_dir }}/.env
ExecStart={{ c_server_bin }} --port 5001 --backend 127.0.0.1 --static {{ static_build_dir }} --api-key ${API_KEY}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Health check on startup - systemd will auto-restart if this fails
ExecStartPost=/bin/sh -c 'for i in 1 2 3 4 5; do curl -sf http://127.0.0.1:5001/health && exit 0; sleep 1; done; exit 1'

# Resource limits (1GB VM)
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
